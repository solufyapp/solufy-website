{
	"compilerOptions": {
		// Basic settings
		"target": "ES2017",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["dom", "dom.iterable", "esnext"],
		"jsx": "react-jsx",
		// Strictness and type checking
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		// JavaScript handling
		"allowJs": true,
		"noEmit": true,
		// Performance optimization
		"incremental": true,
		// Plugins
		"plugins": [
			{
				"name": "next"
			}
		],
		// Path aliases
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
